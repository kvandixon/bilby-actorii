# =============================================================================
# Bilby (ActorII v4.1) — Install & Runtime Configuration Template
# Copy to `.env` before running `docker compose up -d` or `bilby`.
# Inspect or change settings live at runtime via `/config` or `/capabilities`.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Primary LLM Provider, Endpoint, Model & API Key (Tier 0 — Core Reasoning)
#    Supported providers (`ACTORII_LLM_PROVIDER`):
#      - llamacpp   (default: http://127.0.0.1:8080/v1/chat/completions)
#      - ollama     (default: http://127.0.0.1:11434/v1/chat/completions)
#      - vllm       (default: http://127.0.0.1:8000/v1/chat/completions)
#      - openai     (default: https://api.openai.com/v1/chat/completions)
#      - openrouter (default: https://openrouter.ai/api/v1/chat/completions)
#      - gemini     (default: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions)
# -----------------------------------------------------------------------------
ACTORII_LLM_PROVIDER=llamacpp
ACTORII_LLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
ACTORII_LLM_MODEL=qwen3.8:latest
ACTORII_LLM_API_KEY=

# Optional: Enable bounded Step 2/3 deep thinking on reasoning models
ACTORII_ENABLE_THINKING=0

# -----------------------------------------------------------------------------
# 2. Neo4j Graph Memory (`:ActorEpisode` & `:ActorEngram` storage)
#    Start via `docker compose up -d neo4j` (default no-auth local port :7474)
# -----------------------------------------------------------------------------
ACTORII_NEO4J_HTTP_URL=http://127.0.0.1:7474/db/neo4j/tx/commit
ACTORII_NEO4J_USER=
ACTORII_NEO4J_PASSWORD=
ACTORII_MEMORY_NAMESPACE=default

# -----------------------------------------------------------------------------
# 3. Dense Vector Embedding Endpoint (Optional — Hybrid Episodic/Engram Recall)
#    Supports llama-server --embedding (:8084), Ollama, or OpenAI `/v1/embeddings`.
#    Set `ACTORII_EMBED_ENDPOINT=none` to use pure lexical BM25-style recall.
# -----------------------------------------------------------------------------
ACTORII_EMBED_ENDPOINT=http://127.0.0.1:8084/v1/embeddings
ACTORII_EMBED_MODEL=bge-small-en-v1.5
ACTORII_EMBED_API_KEY=

# -----------------------------------------------------------------------------
# 4. Tier 1 Read-Only Research Capabilities (`Actor[#PDF]` & `Actor[#Web]`)
#    `pypdf`, `trafilatura`, and `duckduckgo-search` are pre-installed in the
#    Docker container and work out-of-the-box with `ACTORII_HOST_LOCKDOWN=1`.
#    Optionally set `FIRECRAWL_API_KEY` to enable Firecrawl `/v2/scrape`.
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# 5. Containment & Defense-Up Guardrails (Shipped with Defenses UP by Default)
#    - ACTORII_HOST_LOCKDOWN=1 (Default): Blocks host shell execution and
#      restricts file writes to `/tmp` and `/workspace`.
#    - ACTORII_DISABLE_SELF_EVOLVE=0: Allows guarded Ring-1 cognitive hook
#      evolution (`evolveHarness`); set to 1 to freeze all harness methods.
# -----------------------------------------------------------------------------
ACTORII_HOST_LOCKDOWN=1
ACTORII_DISABLE_SELF_EVOLVE=0

# -----------------------------------------------------------------------------
# 6. Optional: Telegram Gateway Bot Configuration (`actor_telegram.py`)
# -----------------------------------------------------------------------------
# BILBY_TELEGRAM_BOT_TOKEN=your_bot_token_here
# BILBY_TELEGRAM_ALLOWED_CHATS=your_telegram_user_id
