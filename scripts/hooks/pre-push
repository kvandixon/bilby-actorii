#!/usr/bin/env bash
# Mechanical Pre-Push DevOps Gate for ActorII & Bilby
# Installed into .git/hooks/pre-push via scripts/install_hooks.sh
#
# Branch Policy:
# - Pushing to `dev` (or feature branches): requires `--tier fast` stamp (~60s: pytest + scripted self-evo + fast red-team).
# - Pushing to `main` or `refs/tags/v*` (official releases): requires full scope-based stamp (`--tier live` when core files changed since `origin/main`).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Allow explicit emergency bypass ONLY when ACTORII_ALLOW_UNVERIFIED_PUSH=1 is set by a human
if [[ "${ACTORII_ALLOW_UNVERIFIED_PUSH:-0}" == "1" ]]; then
    echo "[pre-push] WARNING: Bypassing release_gate.py check (ACTORII_ALLOW_UNVERIFIED_PUSH=1)" >&2
    exit 0
fi

IS_RELEASE_REF=0
BASE_REF=""

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == refs/tags/v* ]]; then
        IS_RELEASE_REF=1
    fi
    if [[ "$remote_ref" == "refs/heads/main" && "$remote_sha" != "0000000000000000000000000000000000000000" ]] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        BASE_REF="$remote_sha"
    fi
done

if [[ "$IS_RELEASE_REF" -eq 1 ]]; then
    if [[ -z "$BASE_REF" ]] && git rev-parse --verify --quiet origin/main >/dev/null; then
        BASE_REF="origin/main"
    fi
    if [[ -n "$BASE_REF" ]]; then
        python3 "$REPO_ROOT/scripts/release_gate.py" --verify-stamp --base-ref "$BASE_REF"
    else
        python3 "$REPO_ROOT/scripts/release_gate.py" --verify-stamp --require-tier live
    fi
else
    python3 "$REPO_ROOT/scripts/release_gate.py" --verify-stamp --require-tier fast
fi
